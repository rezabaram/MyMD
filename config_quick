# Small, fast smoke test: prolate ellipsoids deposited by gravity onto the
# floor of a solid 1 x 1 x 1.2 box.
#   make run CONFIG=config_quick
# 1000 steps with ~100 particles; finishes in a few seconds.

boxsize		1 1 1.2
boxcorner	0 0 0
density		1
Gravity		0   0   -10

outDt		0.02
timeStep	0.0001
maxTime		0.1

particleSize	0.05
particleSizeWidth 0.01
nParticle	100

stiffness	5e+02
damping		5e+0
friction	2.0e-1
cohesion	0.0

output		out
method		deposition
boundary	solid
eta		1.4
zeta		1.4
